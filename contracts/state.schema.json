{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElementState",
  "description": "Starea unui element al rețelei la o dată. Produs de B, consumat de C (API/UI). Instantaneele sunt GeoJSON FeatureCollection cu aceste câmpuri în properties.",
  "type": "object",
  "required": [
    "element_id",
    "tip_element",
    "nivel",
    "scor",
    "valid_de_la",
    "motive"
  ],
  "properties": {
    "element_id": {
      "type": "string"
    },
    "tip_element": {
      "enum": [
        "nod",
        "tronson",
        "post_transformare"
      ]
    },
    "nivel": {
      "enum": [
        "in_model",
        "predictie",
        "de_verificat",
        "scos_din_uz"
      ],
      "description": "in_model = aplicat; predictie = nesigur, neaplicat (linie punctată în UI); de_verificat = semnal contradictoriu sau scor scăzut; scos_din_uz = demontat (tip activ_demontat), doar peste pragul de aplicare"
    },
    "scor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_de_la": {
      "type": "string",
      "format": "date"
    },
    "ultima_verificare": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "motive": {
      "type": "array",
      "description": "Lista „de ce”, cea mai recentă prima.",
      "items": {
        "type": "object",
        "required": [
          "text",
          "efect"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "efect": {
            "type": "number",
            "description": "schimbarea scorului, ex. +0.25"
          },
          "eveniment": {
            "type": [
              "string",
              "null"
            ],
            "description": "event_id sursă"
          },
          "data": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "predictie": {
      "type": [
        "object",
        "null"
      ],
      "description": "Doar când nivel=predictie sau există o propunere neaplicată (ex. conflict): ce se propune, cu scorul propunerii.",
      "properties": {
        "metoda": {
          "enum": [
            "linie_dreapta",
            "traseu_strada_osm",
            "propunere_proprietate",
            "lant_racordare",
            "zona_mutata",
            "pozitie_din_trace"
          ]
        },
        "urmeaza_strada": {
          "type": [
            "number",
            "null"
          ],
          "description": "0-1, cât de bine urmează strada"
        },
        "propunere": {
          "type": [
            "object",
            "null"
          ],
          "description": "Ce se propune și nu e aplicat: {proprietate: sectiune|element_nou|linie_planificata, valoare}"
        },
        "scor_propunere": {
          "type": [
            "number",
            "null"
          ],
          "description": "scorul propunerii (diferit de scorul elementului)"
        }
      }
    },
    "clasa": {
      "enum": [
        "casa",
        "important",
        "origine",
        "post",
        "aerian",
        "ramura",
        "subteran"
      ],
      "description": "Clasa vizuală din KMZ, derivată de motor: noduri serie 7 = casa, serie 5/6 = important, origine plecare JT = origine, post = post; tronsoane după categorie: aerian, ramura, subteran. Elementele noi primesc clasa din regula din interfaces.md."
    },
    "confirmat_de": {
      "enum": [
        "om",
        null
      ],
      "description": "om = predicția a fost acceptată de un om (sursa om_teren); null = nu"
    }
  }
}
