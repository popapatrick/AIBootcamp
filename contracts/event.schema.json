{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "Eveniment standardizat extras dintr-un raport sau apel. Produs de A (extract_event), consumat de B (apply_event). Date fictive.",
  "type": "object",
  "required": [
    "event_id",
    "echipa_sursa",
    "tip",
    "referinta",
    "status",
    "data",
    "text_original"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ex. EV-001"
    },
    "echipa_sursa": {
      "enum": [
        "mentenanta",
        "investitii",
        "racordari",
        "apel_client",
        "om_teren"
      ],
      "description": "om_teren = decizia unui om (accepta/respinge o predicție) după verificarea în teren"
    },
    "tip": {
      "enum": [
        "racord_nou",
        "activ_inlocuit",
        "linie_planificata",
        "nod_lipsa",
        "avarie_semnalata",
        "verificare",
        "mutare_fire",
        "activ_demontat",
        "cerere_racordare",
        "verificare_om",
        "tracking_tura"
      ],
      "description": "verificare = inspecție în teren fără modificări (confirmă elementul și îi reîmprospătează scorul) sau decizia omului asupra unei predicții (detalii.decizie); mutare_fire = firele dintr-o zonă au fost mutate (detalii.centru/raza_m/motiv); activ_demontat = element scos din uz; cerere_racordare = un client cere racordarea unei case (locația în referinta.coordonate); verificare_om (sesiunea 4) = un om marchează în teren orice element ca verificat (detalii.tinta_id), scorul devine weights.verificat_om.scor; tracking_tura (sesiunea 4b) = tura simulată a tabletei unei echipe (detalii.tura {tura_id, seed, echipa, puncte}); motorul detectează opririle din puncte și scrie detalii.tracking: opriri lângă un stâlp existent = stâlp confirmat, opriri lungi fără stâlp = stâlp presupus (predicție)"
    },
    "referinta": {
      "type": "object",
      "description": "Cel puțin un câmp ar trebui completat; ce lipsește rămâne null.",
      "properties": {
        "element_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "cod nod numeric (ex. 6925190) sau tronson cu prefix de categorie (ex. A-T-054); vezi interfaces.md"
        },
        "coordonate": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            }
          },
          "required": [
            "lat",
            "lon"
          ]
        },
        "adresa": {
          "type": [
            "string",
            "null"
          ]
        },
        "nr_cadastral": {
          "type": [
            "string",
            "null"
          ]
        },
        "id_client": {
          "type": [
            "string",
            "null"
          ],
          "description": "doar pentru apel_client"
        },
        "adresa_structurata": {
          "type": [
            "object",
            "null"
          ],
          "description": "Adresa descompusă de extracție; ce nu apare în text rămâne null. Geocodarea (backend.geo) o folosește.",
          "properties": {
            "strada": {
              "type": [
                "string",
                "null"
              ]
            },
            "numar": {
              "type": [
                "string",
                "null"
              ]
            },
            "localitate": {
              "type": [
                "string",
                "null"
              ]
            },
            "reper": {
              "type": [
                "string",
                "null"
              ]
            },
            "indiciu": {
              "type": [
                "object",
                "null"
              ],
              "description": "Sesiunea 4 (D11/V6): indiciul parțial de loc pe stradă, extras de AI.",
              "properties": {
                "tip": {
                  "enum": [
                    "numar",
                    "langa",
                    "vizavi",
                    "intre",
                    "dupa",
                    "inainte",
                    "capat",
                    "inceput",
                    "colt",
                    "element",
                    "parte"
                  ]
                },
                "numar": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "numar_2": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "doar tip=intre"
                },
                "strada_2": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "doar tip=colt"
                },
                "element_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "doar tip=element (lângă stâlpul X)"
                },
                "distanta_stalpi": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "tip=element: „la 2 stâlpi de X”"
                },
                "paritate": {
                  "enum": [
                    "par",
                    "impar",
                    null
                  ]
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "executat",
        "planificat",
        "semnalat"
      ]
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "forma_sursa": {
      "enum": [
        "campuri",
        "text_liber"
      ]
    },
    "tip_sursa_pondere": {
      "enum": [
        "tableta_coordonate",
        "formular",
        "text_liber",
        "apel_client",
        "om_teren",
        "tracking_gps"
      ],
      "description": "cheia folosită în contracts/weights.yaml; tracking_gps (sesiunea 4b) = poziție GPS din tura unei echipe"
    },
    "text_original": {
      "type": "string"
    },
    "incredere_extractie": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "campuri_lipsa": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detalii": {
      "type": "object",
      "description": "ex. sectiune_noua, lungime_m, observatii, id_partial. Chei pentru tipurile noi mai jos.",
      "properties": {
        "decizie": {
          "type": "object",
          "description": "Doar pentru tip=verificare cu echipa_sursa=om_teren: decizia omului asupra unei predicții.",
          "required": [
            "tinta_id",
            "decizie"
          ],
          "properties": {
            "tinta_id": {
              "type": "string",
              "description": "element_id al predicției (ex. NOU-…)"
            },
            "decizie": {
              "enum": [
                "accepta",
                "respinge"
              ]
            },
            "motiv": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "centru": {
          "type": "object",
          "description": "mutare_fire: centrul zonei",
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            }
          }
        },
        "raza_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "mutare_fire: raza zonei; implicit weights.yaml mutare_fire.raza_m"
        },
        "motiv_mutare": {
          "type": [
            "string",
            "null"
          ],
          "description": "ex. sens_giratoriu"
        },
        "trace": {
          "type": "array",
          "description": "Traseul tabletei din ultima oră (doar rapoarte de tabletă).",
          "items": {
            "type": "object",
            "required": [
              "t",
              "lat",
              "lon"
            ],
            "properties": {
              "t": {
                "type": "string",
                "format": "date-time"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          }
        },
        "trace_rezumat": {
          "type": "object",
          "description": "Scris de motor după procesarea trace-ului: opriri, strada potrivită, alegerea, ambiguitatea."
        },
        "geocodare": {
          "type": "object",
          "description": "Scris de motor/backend.geo: locația dedusă din adresă. metoda: osm_cache | ai_estimare | trace | necunoscut | in_afara_zonei.",
          "properties": {
            "lat": {
              "type": [
                "number",
                "null"
              ]
            },
            "lon": {
              "type": [
                "number",
                "null"
              ]
            },
            "precizie_m": {
              "type": [
                "number",
                "null"
              ]
            },
            "metoda": {
              "enum": [
                "osm_cache",
                "ai_estimare",
                "trace",
                "necunoscut",
                "in_afara_zonei"
              ]
            },
            "acuratete": {
              "type": [
                "number",
                "null"
              ]
            },
            "motiv": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "trace_params": {
          "type": "object",
          "description": "Parametri de generare a traseului simulat (suprascriu weights.trace_generat).",
          "properties": {
            "puncte": {
              "type": "number"
            },
            "zgomot_m": {
              "type": "number"
            },
            "durata_oprire_min": {
              "type": "number"
            },
            "acoperire": {
              "type": "number"
            },
            "decalaj_m": {
              "type": "number"
            }
          }
        },
        "trace_sursa": {
          "enum": [
            "simulat",
            "real"
          ],
          "description": "Origine trace: simulat (generat) sau real (de pe tabletă)."
        },
        "tinta_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "verificare_om: elementul verificat"
        },
        "tura": {
          "type": "object",
          "description": "Doar pentru tip=tracking_tura (sesiunea 4b): tura simulată a tabletei. Opririle NU sunt date aici: motorul le detectează din puncte (backend.trace.gaseste_opriri).",
          "required": [
            "tura_id",
            "puncte"
          ],
          "properties": {
            "tura_id": {
              "type": "string",
              "description": "stabil, derivat din echipă + dată + seed"
            },
            "seed": {
              "type": "string"
            },
            "echipa": {
              "enum": [
                "mentenanta",
                "investitii",
                "racordari"
              ]
            },
            "puncte": {
              "type": "array",
              "description": "puncte GPS cronologice, câte unul la tracking.pas_s secunde",
              "items": {
                "type": "object",
                "required": [
                  "t",
                  "lat",
                  "lon"
                ],
                "properties": {
                  "t": {
                    "type": "string",
                    "description": "ISO datetime"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "tracking": {
          "type": "object",
          "description": "Scris de motor (sesiunea 4b, tracking_tura): {opriri: [{lat, lon, inceput, sfarsit, durata_min, tip: validare|stalp_presupus|scurta|neclara, element_id?, distanta_m?, scor_inainte?, scor_dupa?, banda_inainte?, banda_dupa?, motiv}], validari: [element_id], presupuneri: [element_id TRK-*], ignorate: N, de_ce}. Nu se completează de extracție."
        },
        "intersectie": {
          "type": [
            "object",
            "null"
          ],
          "description": "mutare_fire din document (V4): intersecția unde s-a construit (ex. sens giratoriu)",
          "properties": {
            "strada_1": {
              "type": "string"
            },
            "strada_2": {
              "type": "string"
            }
          }
        },
        "strada_noua": {
          "type": [
            "string",
            "null"
          ],
          "description": "mutare_fire: strada pe care au fost mutate firele, dacă textul o spune"
        },
        "latura": {
          "enum": [
            "nord",
            "sud",
            "est",
            "vest",
            null
          ],
          "description": "mutare_fire: latura ocolirii, dacă textul o spune"
        },
        "cautare_strada": {
          "type": "object",
          "description": "Scris de motor (V6): fereastra de pe stradă și candidații {strada, de_la_m, pana_la_m, punct, precizie_m, metoda: ancore|conventie|indiciu, candidati, ales}."
        },
        "analiza_harta": {
          "type": "object",
          "description": "Scris de motor (V3): drumul pe străzi ales și alternativele."
        }
      }
    }
  }
}
